{
  "expo": {
    "name": "TempleGym",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "backgroundColor": "#A41E35",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#A41E35"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.templegym.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "TempleGym uses your location to confirm you're at the gym when you check in for a workout."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-image",
      "expo-splash-screen",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "83ae0b3c-bb77-4961-ba58-3ba02065d87a"
      }
    },
    "owner": "kentzeccc"
  }
}
