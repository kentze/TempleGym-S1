# Database
DATABASE_URL="postgresql://user:password@localhost:5432/templegym"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# AWS SES (email delivery)
AWS_REGION="ap-northeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
EMAIL_FROM="TempleGym <noreply@templegym.site>"

# OTP
OTP_EXPIRY_MINUTES="10"

# Gym location — Owl Center, TUJ
GYM_LAT="35.6421912"
GYM_LNG="139.6719444"
GYM_RADIUS_M="100"

# Server
PORT="3000"
NODE_ENV="development"
